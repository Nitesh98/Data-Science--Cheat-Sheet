# Copy this file to config.env (same folder) and fill in the channels you want.
# config.env is git-ignored, so your tokens/passwords stay on your machine.
# Leave a line commented out to keep that channel off.

# --- Phone push via ntfy (easiest: no account needed) ---
# 1. Install the "ntfy" app (Android / iOS) and subscribe to a hard-to-guess topic name.
# 2. Put the same topic name here.
# NTFY_TOPIC=nitesh-price-alerts-7f3k9q
# NTFY_SERVER=https://ntfy.sh

# --- Telegram bot ---
# Create a bot with @BotFather, send it a message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# --- Email (e.g. Gmail with an App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# ALERT_EMAIL_TO=you@gmail.com

# --- Desktop pop-ups (on by default on Mac/Windows/Linux desktops) ---
# DESKTOP_NOTIFY=0
